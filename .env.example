# Public client configuration for the hosted Postgres backend.
# These values are publishable (they ship in the client bundle) — no private
# keys or service-role credentials belong in this file.
VITE_SUPABASE_URL="https://<your-project>.supabase.co"
VITE_SUPABASE_PUBLISHABLE_KEY="<your-publishable-key>"
VITE_SUPABASE_PROJECT_ID="<your-project-id>"
